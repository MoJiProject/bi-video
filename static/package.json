{
  "name": "bi-video",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "server": "npm run serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "core-js": "^3.8.3",
    "element-plus": "^2.9.10",
    "pinia": "^3.0.2",
    "sortablejs": "^1.15.6",
    "vue": "^3.2.13",
    "vue-router": "^4.5.1",
    "@element-plus/icons-vue": "^2.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "compression-webpack-plugin": "^11.1.0",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "sass": "^1.89.0",
    "sass-loader": "^16.0.5"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "globals": {
      "defineProps": "readonly",
      "defineEmits": "readonly",
      "defineExpose": "readonly",
      "withDefaults": "readonly"
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {
      "vue/multi-word-component-names": ["error", {
        "ignores": [
          "index",
          "Eit",
          "home",
          "dynamic",
          "contribute",
          "lists",
          "collect",
          "followAnime",
          "settings",
          "follow",
          "fans",
          "search",
          "whisper",
          "comment",
          "Comment",
          "video5",
          "video6",
          "video7",
          "video8",
          "dynamic2",
          "dynamic3",
          "video"
        ]
      }]
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
